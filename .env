# Firebase のウェブアプリ設定（プロジェクト craft-quest-ef2ef）
# どれも Web ページに埋め込まれる公開値なので、リポジトリに入れてかまいません。
# データの保護は firestore.rules で行っています。
#
# ・この PC だけ設定を変えたいときは .env.local に同じ名前で書く（.env.local が優先。Git には入らない）
# ・ログインなしの「ローカルモード」で動かしたいときは、.env.local に次の 1 行を書く
#     NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAnyEJo_UwPViETaHphJjhoprje4zW68NU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=craft-quest-ef2ef.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=craft-quest-ef2ef
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=craft-quest-ef2ef.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=574962719236
NEXT_PUBLIC_FIREBASE_APP_ID=1:574962719236:web:d58798765084751f68f351

# ログインを学校ドメインに絞るときだけ記入（@ より後ろ。例: example.ed.jp）。
# firestore.rules の allowedDomains() と同じ値にする。空なら Google アカウントすべてを許す
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=

# 1 にするとローカルのエミュレーターに接続（npm run emulators と併用。.env.local に書く）
# NEXT_PUBLIC_USE_EMULATORS=1
