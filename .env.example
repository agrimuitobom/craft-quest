# Firebase コンソール →「プロジェクトの設定」→「マイアプリ」のウェブアプリ設定から貼り付け
# （.env.local にコピーして使う。GitHub では Settings → Secrets and variables → Actions → Variables に登録）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 学校の Google Workspace ドメイン（@ より後ろ）。firestore.rules の schoolDomain() と同じ値にする
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=example.ed.jp

# 1 にするとローカルのエミュレーターに接続（npm run emulators と併用）
# NEXT_PUBLIC_USE_EMULATORS=1
