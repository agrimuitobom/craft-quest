rules_version = '2';

// ============================================================
// クラフトクエスト Firestore セキュリティルール
//
//  users/{uid}                … 生徒の進捗（本人のみ読み書き／先生は閲覧のみ）
//  users/{uid}/events/{id}    … 学習ログ（本人は追記のみ／先生は閲覧のみ）
//  teachers/{email}           … 先生の名簿（Firebase コンソールで手動登録）
//
// ★ ログインできるアカウントは allowedDomains() で決まります。
//   空のリスト … Google アカウントならだれでも（個人の Gmail も可）
//   ドメインを並べる … そのドメインのアカウントだけ（例: ['saijo-ah.ed.jp']）
//   変えたら `npm run deploy:rules` でデプロイしてください。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ★ログインを許すメールのドメイン。空なら Google アカウントすべてを許す
    function allowedDomains() {
      return [];
    }

    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isAllowedGoogleUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && (allowedDomains().size() == 0
            || myEmail().split('@')[1] in allowedDomains());
    }

    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/teachers/$(myEmail()));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------- データ検証 ----------
    function validProfile(p) {
      return p is map
        && p.keys().hasOnly(['className', 'studentNumber', 'nickname'])
        && p.className is string && p.className.size() >= 1 && p.className.size() <= 20
        && p.studentNumber is int && p.studentNumber >= 1 && p.studentNumber <= 99
        && p.nickname is string && p.nickname.size() >= 1 && p.nickname.size() <= 12;
    }

    function validProgress(p) {
      return p is map
        && p.version == 1
        && p.exp is int && p.exp >= 0 && p.exp <= 100000
        && p.quests is map
        && p.badges is list && p.badges.size() <= 50;
    }

    function validUserDoc(d) {
      return d.keys().hasOnly(['email', 'googleName', 'profile', 'progress', 'createdAt', 'updatedAt'])
        && d.email == myEmail()
        && d.googleName is string && d.googleName.size() <= 100
        && validProfile(d.profile)
        && validProgress(d.progress)
        && d.updatedAt == request.time;
    }

    // ふりかえり（reflect）のログ：選択肢の値だけ。ひとことはログに入れない
    function validReflectLog(d) {
      return d.type == 'reflect'
        ? (d.stuck in ['none', 'goal', 'code', 'game', 'bug']
            && (!('solved' in d) || d.solved in ['self', 'hint', 'reread', 'friend', 'teacher']))
        : !('stuck' in d) && !('solved' in d);
    }

    // ---------- 生徒の進捗 ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isTeacher();

      allow create: if isOwner(uid)
        && (isAllowedGoogleUser() || isTeacher())
        && validUserDoc(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid)
        && (isAllowedGoogleUser() || isTeacher())
        && validUserDoc(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;

      // 削除は先生もアプリからは不可（年度末の整理はコンソールで）
      allow delete: if false;

      // ---------- 学習ログ（追記のみ） ----------
      match /events/{eventId} {
        allow read: if isOwner(uid) || isTeacher();
        allow create: if isOwner(uid)
          && (isAllowedGoogleUser() || isTeacher())
          && request.resource.data.keys().hasOnly(['type', 'questId', 'hintLevel', 'attempt', 'exp', 'stuck', 'solved', 'at'])
          && request.resource.data.type in ['start', 'hint', 'fail', 'clear', 'reflect']
          && request.resource.data.questId is string
          && request.resource.data.questId.size() <= 40
          && validReflectLog(request.resource.data)
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    // ---------- 先生名簿（自分のドキュメントの有無だけ確認できる） ----------
    match /teachers/{email} {
      allow get: if signedIn() && myEmail() == email;
      allow list, write: if false;
    }
  }
}
